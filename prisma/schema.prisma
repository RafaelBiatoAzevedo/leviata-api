generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
}

// Analytics is isolated from CMS data. UUID identifies a pageview, never a person.
model AnalyticsEvent {
  id      String   @id @db.Uuid
  day     DateTime @db.Date
  path    String   @db.VarChar(150)
  source  String   @db.VarChar(20)
  device  String   @db.VarChar(20)
  browser String   @db.VarChar(20)

  @@index([day])
}

model AnalyticsMonth {
  month  String  @id @db.VarChar(7)
  used   Int     @default(0)
  capped Boolean @default(false)
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum ArticleType {
  ARTICLE
  DOSSIER
}

enum PersonCategory {
  DOCENTE
  DISCENTE
  EGRESSO
  PESQUISADOR
  SUB_COORDENADOR
  COORDENADOR
  EXTERNO
}

enum ResearchInstrumentType {
  DOSSIER
  CATALOG
  DATABASE
}

enum MeetingType {
  SEMINAR
  MEETING
  DOCUMENTARY
  SYMPOSIUM
}

enum BoardType {
  QUALIFICATION
  DEFENSE
}

enum NewsCategory {
  PUBLICATION // publicação
  EVENT       // evento
  AWARD       // premiação
  INTERNSHIP  // estágio
  RESEARCH    // pesquisa
  PODCAST     // podcast
  CALL        // convocação
}

enum NewsRelatedType {
  BOARD
  JURY
  MEETING
  PUBLICATION
  RESEARCH_INSTRUMENT
  THEMATIC
  RESEARCH
  PRESENTED_WORK
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String

  firstName String?
  lastName  String?

  hashedRefreshToken String?
  tokenVersion Int @default(0)

  role      Role     @default(ADMIN)

  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  deletedById String?
  approvedComments Comment[]
  notificationReads NotificationRead[]
  createdNotifications Notification[]
}

enum CommentTarget {
  THEMATIC
  RESEARCH_INSTRUMENT
  BOARD
  JURY
  MEETING
  PRESENTED_WORK
  RESEARCH
  NEWS
}

enum CommentStatus {
  PENDING
  APPROVED
}

enum NotificationType {
  INFO
  REMINDER
  COMMENT
}

enum NotificationResolution {
  APPROVED
  REJECTED
}

model Comment {
  id String @id @default(uuid())
  targetType CommentTarget
  targetId String
  fullName String @db.VarChar(120)
  text String @db.VarChar(300)
  status CommentStatus @default(PENDING)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  approvedAt DateTime? @db.Timestamptz(3)
  approvedById String?
  approvedBy User? @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  notification Notification?

  @@index([targetType, targetId, status, createdAt])
}

model Notification {
  id String @id @default(uuid())
  type NotificationType
  title String @db.VarChar(120)
  message String @db.VarChar(500)
  targetTitle String?
  targetPath String?
  commentId String? @unique
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  resolution NotificationResolution?
  resolvedAt DateTime? @db.Timestamptz(3)
  createdById String?
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  visibleAt DateTime @default(now()) @db.Timestamptz(3)
  reads NotificationRead[]

  @@index([visibleAt, createdAt])
  @@index([type, resolution])
}

model NotificationRead {
  notificationId String
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([notificationId, userId])
  @@index([userId])
}

model AcademicTitle {
  id           String @id @default(uuid())
  
  name         String @unique
  abbreviation String @unique

  people       Person[]
}

model Country {
  id        String @id @default(uuid())

  code      String @unique
  name      String @unique

  institutions Institution[]
  nationals Person[] @relation("Nationality")
}


model Institution {
  id   String @id @default(uuid())

  name String @unique
  acronym String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  countryId String
  country   Country @relation(fields: [countryId], references: [id])

  people Person[]

  deletedAt   DateTime?
  deletedById String?
}

model Person {
  id String @id @default(uuid())

  slug String @unique
  isActive Boolean @default(true)
  displayOrder Int @default(0)

  imageUrl String?
  imagePublicId String?
  
  name String

  birthDate DateTime?

  category PersonCategory

  bio  String?
  orcid String?
  email String?

  lattesUrl String?
  website String?
  linkedinUrl String?

  honorificTitle String?

  videos Video[]

  books Book[]

  articles Article[]

  thematicVideos ThematicVideo[]

  researchInstruments ResearchInstrument[]

  boardCandidates Board[] @relation("BoardCandidate")

  boardAdvisors Board[] @relation("BoardAdvisor")

  boardMemberships Board[] @relation("BoardMembers")

  juryJudges Jury[] @relation("JuryJudges")

  juryJurors Jury[] @relation("JuryJurors")

  juryProsecutors Jury[] @relation("JuryProsecutors")

  juryDefenders Jury[] @relation("JuryDefenders")

  juryBailiffs Jury[] @relation("JuryBailiffs")

  nationalityId String?
  nationality   Country? @relation("Nationality", fields: [nationalityId], references: [id])

  academicTitleId String?
  academicTitle   AcademicTitle? @relation(fields: [academicTitleId], references: [id])

  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  
  coordinatedThematics Thematic[] @relation("ThematicCoordinator")

  meetingsAsSpeaker Meeting[] @relation("MeetingSpeakers")

  presentedWorks PresentedWork[]

  searchs Search[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt   DateTime?
  deletedById String?
}


model Book {
  id String @id @default(uuid())

  slug String @unique

  title       String
  subtitle    String?

  coverUrl    String?
  coverPublicId   String?
  
  description String?

  isbn        String?

  year        Int?

  publisher   String?

  externalUrl String?

  authors Person[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt   DateTime?
  deletedById String?
}


model Article {
  id String @id @default(uuid())

  slug String @unique

  title String

  coverUrl String?
  coverPublicId String?

  type ArticleType @default(ARTICLE)

  journal String?

  volume  String?

  year Int?

  doi String?

  summary String?

  externalUrl String?

  authors Person[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt   DateTime?
  deletedById String?
}

model Board {
  id String @id @default(uuid())

  slug String @unique

  title String

  // Existing boards remain unclassified until reviewed in the admin.
  type BoardType?

  candidateId String
  candidate   Person @relation("BoardCandidate", fields: [candidateId], references: [id])

  advisorId String
  advisor   Person @relation("BoardAdvisor", fields: [advisorId], references: [id])

  members Person[] @relation("BoardMembers")

  date DateTime

  images Image[]

  meetingUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedById String?
}

model Jury {
  id String @id @default(uuid())

  slug String @unique

  title String

  coverUrl String?
  coverPublicId String?

  description String?

  date DateTime

  location String?

  images Image[]

  judges Person[] @relation("JuryJudges")

  jurors Person[] @relation("JuryJurors")

  prosecutors Person[] @relation("JuryProsecutors")

  defenders Person[] @relation("JuryDefenders")

  bailiffs Person[] @relation("JuryBailiffs")

  documentUrl String?
  registrationUrl String?
  recordingUrl String?
  meetingUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedById String?
}

model PresentedWork {
  id String @id @default(uuid())

  slug String @unique

  title String

  date DateTime

  location String?

  images Image[]

  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id])

  authors Person[]

  documentUrl String?
  registrationUrl String?
  recordingUrl String?
  meetingUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedById String?
}

model Meeting {
  id String @id @default(uuid())
  slug String @unique

  type MeetingType

  isInternal Boolean @default(true)

  title String

  coverUrl String?
  coverPublicId String?

  description String?

  date DateTime

  location String?

  registrationUrl String?
  recordingUrl String?
  meetingUrl String?

  speakers Person[] @relation("MeetingSpeakers")

  presentedWorks PresentedWork[]

  scheduleEntries Schedule[]

  images Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedById String?
}

model Image {
  id String @id @default(uuid())

  imageUrl String

  publicId String? @unique

  title String?

  description String?

  boardId String?
  board Board? @relation(fields: [boardId], references: [id])

  juryId String?
  jury Jury? @relation(fields: [juryId], references: [id])

  meetingId String?
  meeting Meeting? @relation(fields: [meetingId], references: [id])

  presentedWorkId String?
  presentedWork PresentedWork? @relation(fields: [presentedWorkId], references: [id])

  newsId String?
  news News? @relation(fields: [newsId], references: [id])

  photos Search[] @relation("SearchImages")
  supports Search[] @relation("SearchSupports")

  createdAt DateTime @default(now())

  @@index([newsId])
}

model Video {
  id String @id @default(uuid())
  slug String @unique

  title String

  embedLink String

  description String?

  people Person[]

  thematicMain Thematic[] @relation("ThematicMainVideo")

  thematicVideos ThematicVideo[]
  
  createdAt DateTime @default(now())
  deletedAt DateTime?
  deletedById String?
}

model ThematicVideo {
  id String @id @default(uuid())

  thematicId String
  thematic   Thematic @relation(fields: [thematicId], references: [id])

  videoId String
  video   Video @relation(fields: [videoId], references: [id])

  personId String?
  person Person? @relation(fields: [personId], references: [id])

  title String

  description String?

  createdAt DateTime @default(now())
}

model Thematic {
  id String @id @default(uuid())
  slug String @unique

  title String

  description String?

  mainVideoId String?
  mainVideo Video? @relation("ThematicMainVideo", fields: [mainVideoId], references: [id])

  coordinatorId String?
  coordinator Person? @relation("ThematicCoordinator", fields: [coordinatorId], references: [id])

  additionalVideos ThematicVideo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedById String?
}

model News {
  id String @id @default(uuid())

  slug String @unique

  title String

  description String

  coverUrl String?
  coverPublicId String?

  date DateTime

  category NewsCategory

  isInternal Boolean @default(false)

  externalUrl String?

  relatedType NewsRelatedType?
  relatedId String?

  images Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedById String?
}

model Schedule {
  id String @id @default(uuid())

  slug String @unique

  title String
  subtitle String?
  description String? @db.Text

  date DateTime
  endDate DateTime?

  location String?
  externalUrl String?

  meetingId String?
  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedById String?

  @@index([deletedAt, date])
  @@index([meetingId])
}

enum NewsletterMailRecipientStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
  UNKNOWN
}

model NewsletterMailCampaign {
  id String @id @default(uuid())
  newsletterId String @unique
  newsletter Newsletter @relation(fields: [newsletterId], references: [id])
  title String
  subject String
  htmlContent String @db.Text
  pdfContent Bytes?
  slug String
  createdById String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)
  recipients NewsletterMailRecipient[]
}

model NewsletterMailRecipient {
  id String @id @default(uuid())
  campaignId String
  campaign NewsletterMailCampaign @relation(fields: [campaignId], references: [id])
  subscriberId String
  subscriber NewsletterSubscriber @relation(fields: [subscriberId], references: [id])
  email String
  status NewsletterMailRecipientStatus @default(PENDING)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(3)
  lastAttemptAt DateTime? @db.Timestamptz(3)
  sentAt DateTime? @db.Timestamptz(3)
  messageId String?
  errorCode String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([campaignId, subscriberId])
  @@index([status, nextAttemptAt])
  @@index([lastAttemptAt])
  @@index([sentAt])
}

model Newsletter {
  id String @id @default(uuid())

  slug String @unique

  title String

  subject String

  htmlContent String @db.Text

  contentData Json?

  coverUrl String?
  coverPublicId String?

  pdfUrl String?
  pdfContent Bytes?
  pdfSourceHash String?
  pdfGeneratedAt DateTime?

  publishedAt DateTime?

  sentAt DateTime?

  deliveries NewsletterDelivery[]
  mailCampaign NewsletterMailCampaign?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedById String?
}

model NewsletterSubscriber {
  id String @id @default(uuid())

  email String @unique

  name String?

  cellphone String?

  allowEmail Boolean @default(true)

  allowWhatsapp Boolean @default(false)

  isActive Boolean @default(true)

  subscribedAt DateTime @default(now())

  unsubscribedAt DateTime?

  deliveries NewsletterDelivery[]
  mailRecipients NewsletterMailRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedById String?
}

model NewsletterDelivery {
  id String @id @default(uuid())

  newsletterId String
  newsletter Newsletter @relation(fields: [newsletterId], references: [id])

  subscriberId String
  subscriber NewsletterSubscriber @relation(fields: [subscriberId], references: [id])

  sentAt DateTime

  openedAt DateTime?

  clickedAt DateTime?

  errorMessage String?
}

model ResearchInstrument {
  id String @id @default(uuid())

  slug String @unique

  type ResearchInstrumentType

  title String

  startYear Int?
  endYear Int?

  content String?

  pdfUrl String?
  pdfPublicId String?

  externalUrl String?

  people Person[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedById String?
}

model Search {
  id String @id @default(uuid())

  slug String @unique

  title String

  coverUrl String?
  coverPublicId String?

  content String?

  people Person[]

  images Image[] @relation("SearchImages")

  supports Image[] @relation("SearchSupports")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedById String?
}
