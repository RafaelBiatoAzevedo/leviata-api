generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum ArticleType {
  ARTICLE
  DOSSIER
}

enum PersonCategory {
  DOCENTE
  DISCENTE
  EGRESSO
  PESQUISADOR
  SUB_COORDENADOR
  COORDENADOR
}

enum ResearchInstrumentType {
  DOSSIER
  CATALOG
  DATABASE
}

enum MeetingType {
  SEMINAR
  MEETING
}

enum NewsCategory {
  PUBLICATION // publicação
  EVENT       // evento
  AWARD       // premiação
  INTERNSHIP  // estágio
  RESEARCH    // pesquisa
  PODCAST     // podcast
  CALL        // convocação
}

enum NewsRelatedType {
  BOARD
  JURY
  MEETING
  PUBLICATION
  RESEARCH_INSTRUMENT
  THEMATIC
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String

  firstName String?
  lastName  String?

  hashedRefreshToken String?

  role      Role     @default(ADMIN)

  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcademicTitle {
  id           String @id @default(uuid())
  
  name         String @unique
  abbreviation String @unique

  people       Person[]
}

model Country {
  id        String @id @default(uuid())

  code      String @unique
  name      String @unique

  institutions Institution[]
  nationals Person[] @relation("Nationality")
}


model Institution {
  id   String @id @default(uuid())

  name String @unique
  acronym String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  countryId String
  country   Country @relation(fields: [countryId], references: [id])

  people Person[]

  deletedAt   DateTime?
  deletedById String?
}

model Person {
  id String @id @default(uuid())

  slug String @unique
  isActive Boolean @default(true)
  displayOrder Int @default(0)

  imageUrl String?
  imagePublicId String?
  
  name String

  birthDate DateTime?

  category PersonCategory

  bio  String?
  orcid String?
  email String?

  lattesUrl String?
  website String?
  linkedinUrl String?

  honorificTitle String?

  videos Video[]

  books Book[]

  articles Article[]

  thematicVideos ThematicVideo[]

  researchInstruments ResearchInstrument[]

  boardCandidates Board[] @relation("BoardCandidate")

  boardAdvisors Board[] @relation("BoardAdvisor")

  boardMemberships Board[] @relation("BoardMembers")

  juryJudges Jury[] @relation("JuryJudges")

  juryJurors Jury[] @relation("JuryJurors")

  juryProsecutors Jury[] @relation("JuryProsecutors")

  juryDefenders Jury[] @relation("JuryDefenders")

  juryBailiffs Jury[] @relation("JuryBailiffs")

  nationalityId String?
  nationality   Country? @relation("Nationality", fields: [nationalityId], references: [id])

  academicTitleId String?
  academicTitle   AcademicTitle? @relation(fields: [academicTitleId], references: [id])

  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  
  coordinatedThematics Thematic[] @relation("ThematicCoordinator")

  meetingsAsSpeaker Meeting[] @relation("MeetingSpeakers")

  presentedWorks PresentedWork[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt   DateTime?
  deletedById String?
}


model Book {
  id String @id @default(uuid())

  slug String @unique

  title       String
  subtitle    String?

  coverUrl    String?
  coverPublicId   String?
  
  description String?

  isbn        String?

  year        Int?

  publisher   String?

  externalUrl String?

  authors Person[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt   DateTime?
  deletedById String?
}


model Article {
  id String @id @default(uuid())

  slug String @unique

  title String

  coverUrl String?
  coverPublicId String?

  type ArticleType @default(ARTICLE)

  journal String?

  volume  String?

  year Int?

  doi String?

  summary String?

  externalUrl String?

  authors Person[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt   DateTime?
  deletedById String?
}

model Board {
  id String @id @default(uuid())

  slug String @unique

  title String

  candidateId String
  candidate   Person @relation("BoardCandidate", fields: [candidateId], references: [id])

  advisorId String
  advisor   Person @relation("BoardAdvisor", fields: [advisorId], references: [id])

  members Person[] @relation("BoardMembers")

  date DateTime

  images Image[]

  meetingUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Jury {
  id String @id @default(uuid())

  slug String @unique

  title String

  date DateTime

  images Image[]

  judges Person[] @relation("JuryJudges")

  jurors Person[] @relation("JuryJurors")

  prosecutors Person[] @relation("JuryProsecutors")

  defenders Person[] @relation("JuryDefenders")

  bailiffs Person[] @relation("JuryBailiffs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PresentedWork {
  id String @id @default(uuid())

  slug String @unique

  title String

  date DateTime

  images Image[]

  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id])

  authors Person[]
}

model Meeting {
  id String @id @default(uuid())
  slug String @unique

  type MeetingType

  title String

  coverImage String?

  description String?

  date DateTime

  location String?

  registrationUrl String?

  meetingUrl String?

  speakers Person[] @relation("MeetingSpeakers")

  presentedWorks PresentedWork[]

  images Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Image {
  id String @id @default(uuid())

  imageUrl String

  description String?

  boardId String?
  board Board? @relation(fields: [boardId], references: [id])

  juryId String?
  jury Jury? @relation(fields: [juryId], references: [id])

  meetingId String?
  meeting Meeting? @relation(fields: [meetingId], references: [id])

  presentedWorkId String?
  presentedWork PresentedWork? @relation(fields: [presentedWorkId], references: [id])

  createdAt DateTime @default(now())
}

model Video {
  id String @id @default(uuid())

  title String

  embedLink String

  description String?

  people Person[]

  thematicMain Thematic[] @relation("ThematicMainVideo")

  thematicVideos ThematicVideo[]
  
  createdAt DateTime @default(now())
}

model ThematicVideo {
  id String @id @default(uuid())

  thematicId String
  thematic   Thematic @relation(fields: [thematicId], references: [id])

  videoId String
  video   Video @relation(fields: [videoId], references: [id])

  personId String?
  person Person? @relation(fields: [personId], references: [id])

  title String

  description String?

  createdAt DateTime @default(now())
}

model Thematic {
  id String @id @default(uuid())

  title String

  description String?

  mainVideoId String?
  mainVideo Video? @relation("ThematicMainVideo", fields: [mainVideoId], references: [id])

  coordinatorId String?
  coordinator Person? @relation("ThematicCoordinator", fields: [coordinatorId], references: [id])

  additionalVideos ThematicVideo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedById String?
}

model News {
  id String @id @default(uuid())

  slug String @unique

  title String

  description String

  coverUrl String?
  coverPublicId String?

  date DateTime

  category NewsCategory

  isInternal Boolean @default(false)

  externalUrl String?

  relatedType NewsRelatedType?
  relatedId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedById String?
}

model Newsletter {
  id String @id @default(uuid())

  slug String @unique

  title String

  subject String

  htmlContent String @db.Text

  coverUrl String?

  pdfUrl String?

  publishedAt DateTime?

  sentAt DateTime?

  deliveries NewsletterDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedById String?
}

model NewsletterSubscriber {
  id String @id @default(uuid())

  email String @unique

  name String?

  cellphone String?

  allowEmail Boolean @default(true)

  allowWhatsapp Boolean @default(false)

  isActive Boolean @default(true)

  subscribedAt DateTime @default(now())

  unsubscribedAt DateTime?

  deliveries NewsletterDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterDelivery {
  id String @id @default(uuid())

  newsletterId String
  newsletter Newsletter @relation(fields: [newsletterId], references: [id])

  subscriberId String
  subscriber NewsletterSubscriber @relation(fields: [subscriberId], references: [id])

  sentAt DateTime

  openedAt DateTime?

  clickedAt DateTime?

  errorMessage String?
}

model ResearchInstrument {
  id String @id @default(uuid())

  slug String @unique

  type ResearchInstrumentType

  title String

  startYear Int?
  endYear Int?

  content String?

  pdfUrl String?

  externalUrl String?

  people Person[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?
  deletedById String?
}


