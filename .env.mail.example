# Copie este bloco para o .env da API. Nunca coloque estas chaves no frontend.
# O cadastro de newsletters/inscritos funciona com o envio desativado.
MAIL_ENABLED=false
MAIL_WORKER_ENABLED=true
MAIL_FROM_NAME="Leviatã e o Cativeiro"
MAIL_FROM_EMAIL=leviataeocativeiro@gmail.com
MAIL_REPLY_TO=leviataeocativeiro@gmail.com
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_SMTP_USER=leviataeocativeiro@gmail.com

# Recomendado: OAuth2 do Google (escopo https://mail.google.com/).
MAIL_AUTH_MODE=oauth2
MAIL_GOOGLE_CLIENT_ID=
MAIL_GOOGLE_CLIENT_SECRET=
MAIL_GOOGLE_REFRESH_TOKEN=

# Alternativa: MAIL_AUTH_MODE=app-password e senha de aplicativo do Gmail.
# Não use a senha normal da conta.
MAIL_GMAIL_APP_PASSWORD=

# Gere uma chave estável com: openssl rand -hex 32
MAIL_UNSUBSCRIBE_SECRET=

# Em produção, substitua pelas URLs HTTPS públicas da API e do portal.
MAIL_PUBLIC_API_URL=http://localhost:3000
MAIL_PORTAL_URL=http://localhost:5173

# Limites compartilhados pelos workers desta API; Gmail possui limites próprios.
MAIL_DAILY_LIMIT=400
MAIL_SEND_INTERVAL_MS=5000
MAIL_MAX_ATTEMPTS=3
